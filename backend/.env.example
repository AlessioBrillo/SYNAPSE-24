# SYNAPSE-24 Dashboard Backend Environment Variables
# Copy to .env and fill in your device details

# ==================== SYNAPSE-24 Configuration ====================
# Path to config directory (relative to backend/ or absolute)
SYNAPSE_CONFIG_DIR=../config

# LSL network scope: 'local' for same machine, 'network' for multi-host
SYNAPSE_LSL_NETWORK=local

# Use mock data for development (set to 'false' for real hardware)
SYNAPSE_MOCK_MODE=true

# ==================== Hardware Connections ====================
# Forearm Hub (Tier 0) - ESP32 with MAX30102 (PPG) + ICM-20948 (IMU) + AD8232 (ECG)
SYNAPSE_FOREARM_BLE=AA:BB:CC:DD:EE:FF
SYNAPSE_FOREARM_SERIAL=/dev/ttyUSB0

# Head Pod (Tier 1) - Cerelog ESP-EEG with ADS1299 (8-ch EEG) + MAX86141 (fNIRS)
SYNAPSE_HEAD_BLE=11:22:33:44:55:66
SYNAPSE_HEAD_SERIAL=/dev/ttyUSB1

# In-Ear Satellite (Tier 0 continuity) - Custom earbud AFE
SYNAPSE_EAR_BLE=77:88:99:AA:BB:CC

# ==================== LSL Settings ====================
# LSL clock domain: 'local_clock' (NTP-synced) or 'time' (wall clock)
SYNAPSE_CLOCK_DOMAIN=local_clock

# LSL stream name prefix (for multi-session isolation)
SYNAPSE_LSL_PREFIX=SYNAPSE

# ==================== Redis (Optional) ====================
# Redis for caching/session storage
REDIS_URL=redis://localhost:6379

# ==================== API Settings ====================
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# ==================== Data Plane API (backend/main.py) ====================
# Bearer token protecting every /api endpoint (except the /api/health
# liveness probe). When it is EMPTY the API is unauthenticated: fine for
# local development, unsafe as soon as the port is reachable by someone else.
SYNAPSE_API_TOKEN=

# Directory holding the indexed sessions (XDF / FIT files).
SYNAPSE_SESSIONS_DIR=../data/sessions

# Extra directories a client-supplied file_path may point into, separated by
# the OS path separator (';' on Windows, ':' on Linux/macOS).
SYNAPSE_DATA_ROOTS=

# Extra CORS origins allowed to call the API (comma separated). The Vite dev
# server origins are always allowed; the wildcard '*' is refused.
SYNAPSE_CORS_ORIGINS=

# WebSocket ping interval (seconds)
WS_PING_INTERVAL=30

# ==================== Logging ====================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Structured JSON logging (for production)
JSON_LOGS=false