# SYNAPSE-24 Phase 1 Hardware Bringup Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (already in .gitignore)

# Forearm Hub (Tier 0 Continuous) - ESP32-S3 Tier 0 Pod
# Serial port for firmware flashing and USB CDC logging
SYNAPSE_FOREARM_SERIAL=COM3

# BLE MAC address for live BLE connection (optional - "auto" scans for SYNAPSE device)
# Format: aa:bb:cc:dd:ee:ff (lowercase with colons)
# Leave as "auto" for automatic discovery during bringup
SYNAPSE_FOREARM_BLE=auto

# Head Pod (Tier 1 High-Density) - Cerelog ESP-EEG
# Serial port for USB CDC connection (Linux: /dev/ttyUSB0, Windows: COM4, etc.)
SYNAPSE_HEAD_SERIAL=/dev/ttyUSB0

# BLE MAC address for Cerelog (optional - "auto" scans)
SYNAPSE_HEAD_BLE=auto

# In-Ear Satellite (Tier 0 Continuous EEG) - Future Phase 2
# SYNAPSE_EAR_BLE=auto

# Optional: Custom output directory for live validation XDF files
# SYNAPSE_LIVE_OUTPUT_DIR=data/processed/live_validation

# Optional: Log level for bringup scripts (DEBUG, INFO, WARNING, ERROR)
# SYNAPSE_LOG_LEVEL=INFO