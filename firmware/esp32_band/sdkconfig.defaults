# Synapse Band v1 - ESP32-S3 SDK Configuration
# Based on esp32_forearm/esp32_tier0 with Band-specific adjustments

# Flash: DevKitC-1 N8R8 (WROOM-1-N8R8, 8 MB Quad flash + 8 MB Octal PSRAM).
# See docs/hardware/PROCUREMENT.md G1 — the smoke kit board is N8R8.
# partitions.csv below uses a 6 MB layout, which fits the 8 MB chip.
# Do NOT set 16MB here: the N16R8V variant uses a different module
# (WROOM-2, 1.8V Octal flash/PSRAM) and this project targets WROOM-1.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE=8MB
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ=80M

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM support (required for TFLM tensor arena ~60KB model + activations)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=65536
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_CACHE_WORKAROUND=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# BLE Configuration (NimBLE — same stack as head/forearm/common)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL=0

CONFIG_BT_NIMBLE_GATT_MAX_CLIENTS=1
CONFIG_BT_NIMBLE_GATT_MAX_SERVICES=12
CONFIG_BT_NIMBLE_GATT_MAX_ATTRS=48
CONFIG_BT_NIMBLE_GATT_MAX_CCCDS=8

CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="SYNAPSE-BAND"

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3072

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

CONFIG_I2C_ISR_HANDLER_IN_IRAM=y

CONFIG_SPI_FLASH_CACHE_LINE_SIZE_64=y
CONFIG_SPI_FLASH_CACHE_LINE_SIZE=64

CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384

CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000

CONFIG_ESP_ERR_TO_NAME_LOOKUP=y

# SPIFFS for FIT storage (built-in component; partition subtype 'spiffs')
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_SIZE=2048

# In-ear/aux flags consumed by Synapse Research Service
# Raw sample streams (ECG/PPG/IMU) + on-device timestamps, no on-device features.
CONFIG_SYNAPSE_FEATURE_RESEARCH_SERVICE=y

# UART for GPS
CONFIG_UART_ISR_IN_IRAM=y